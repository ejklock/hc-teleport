#!/bin/bash
# Stands in for Claude Code: registers a session the way the real one does
# (the given id for `--resume <id>`, a fresh one otherwise), reports idle on
# its terminal, then stays alive as a process named claude until it is killed.
set -eu
if [ "${1:-}" = "--version" ]; then
  echo "2.1.321 (Claude Code)"
  exit 0
fi
session_id=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = "--resume" ] && [ "$#" -gt 1 ]; then
    session_id="$2"
    shift
  fi
  shift
done
config_dir="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
mkdir -p "${config_dir}/sessions"
if [ -z "${session_id}" ]; then
  session_id="$(cat /proc/sys/kernel/random/uuid)"
fi
printf '{"pid":%s,"sessionId":"%s","cwd":"%s","version":"2.1.321"}\n' \
  "$$" "${session_id}" "${PWD}" > "${config_dir}/sessions/$$.json"
# OSC 7501 with state=idle, closed by ST: the report hc reads from a terminal's
# output: parsed by crates/ghostty-vt/src/lib.rs:327-341 (on_program_status) and
# written by crates/herdr-core/src/status.rs:57 (Status::encode), herdr-core v0.1.19.
printf '\033]7501;state=idle\033\\'
exec -a claude sleep infinity
