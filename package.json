{
  "name": "hc-teleport",
  "version": "0.3.0",
  "description": "Move a coding-agent session between machines from an hc terminal",
  "author": "Evaldo Klock",
  "private": true,
  "type": "module",
  "bin": {
    "hc-teleport": "dist/src/app/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "vitest run",
    "test:bed": "vitest run --config vitest.bed.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit false --outDir dist",
    "lint": "eslint .",
    "coverage": "vitest run --coverage && se-gates qg coverage-receipt"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "^4.10.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.0"
  }
}
